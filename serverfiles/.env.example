# Default Firebird 5 database (exposed to MCP clients as "default").
# Host: host.docker.internal = Firebird on the docker host (local), or a hostname/IP (remote).
# FIREBIRD_DATABASE is the path/alias on the Firebird server.
FIREBIRD_HOST=host.docker.internal
FIREBIRD_PORT=3050
FIREBIRD_USER=mcp_reader
FIREBIRD_PASSWORD=replace_with_reader_password
FIREBIRD_DATABASE=C:/Firebird/database.fdb
# Disabled | Enabled | Required
FIREBIRD_CONF_WIRECRYPT=Enabled
#FIREBIRD_CHARSET=UTF8

# Each write operation is independently opt-in, for this database only.
# Requires FIREBIRD_API_KEY and a distinct, non-SYSDBA writer (never falls back to reader).
FIREBIRD_ALLOW_INSERT_ROWS=false
FIREBIRD_ALLOW_UPDATE_ROWS=false
FIREBIRD_ALLOW_DELETE_ROWS=false
FIREBIRD_ALLOW_CREATE_TABLE=false
FIREBIRD_ALLOW_DROP_TABLE=false
#FIREBIRD_WRITER_USER=mcp_writer
#FIREBIRD_WRITER_PASSWORD=replace_with_writer_password

# Additional databases (any number): Databases__<name>__<Setting>
#Databases__erp__Host=10.0.0.5
#Databases__erp__Port=3050
#Databases__erp__Database=/data/erp.fdb
#Databases__erp__User=mcp_reader
#Databases__erp__Password=replace_with_reader_password
#Databases__erp__WireCrypt=Enabled
#Databases__erp__Charset=UTF8
#Databases__erp__WriterUser=mcp_writer
#Databases__erp__WriterPassword=replace_with_writer_password
#Databases__erp__AllowInsertRows=false
#Databases__erp__AllowUpdateRows=false
#Databases__erp__AllowDeleteRows=false
#Databases__erp__AllowCreateTable=false
#Databases__erp__AllowDropTable=false

# MCP server access token. Clients connect with: Authorization: Bearer <token>
# Empty = unprotected read-only endpoint; startup fails if any writes are enabled.
# Generate a unique high-entropy token; do not use this placeholder.
FIREBIRD_API_KEY=replace_with_a_random_secret_token

# Allowed Host headers (comma separated); add the server name when accessed remotely
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp-firebird

# docker-compose published port: http://<MCP_BIND>:<MCP_PORT>/mcp
MCP_BIND=127.0.0.1
MCP_PORT=8182
